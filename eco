#!/usr/bin/env bash
# eco: eco-power convergence tool. Three verbs (report, apply, harvest), two flags
# (--json, --dry-run), shared exit codes. See eco --help.
set -euo pipefail

ECO_HOME=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
for _eco_lib in "$ECO_HOME"/lib/*.sh; do
  . "$_eco_lib"
done
shopt -s nullglob

usage() {
  cat <<'EOF'
usage: eco <verb> [flag]

verbs:
  report    read-only verdict over the 14 power-stack checks (default)
  apply     converge the live system to repo state (root; idempotent)
  harvest   print a unified diff proposal from live to intent state (writes nothing)

flags:
  --json      with report: stable machine-readable output
  --dry-run   with apply: print the plan, write nothing

exit codes:
  0  no DRIFT (rows may be SKIPPED where a check needs root or a user session)
  1  DRIFT present (report) or persisted after apply
  2  precondition failure (bad argument, lock held by a real apply, missing state file)
  3  apply step failed (partial; applied and not-applied targets listed)

verdict classes: OK, ACCEPTED (a settled decision where live legitimately differs),
WARN (known quirk or expected transient), DRIFT (actionable mismatch), SKIPPED
(a check that needs root or a user session; counted green, means unverified).
EOF
}

usage_err() {
  printf 'eco: unknown argument: %s\n' "${1:-}" >&2
  usage >&2
  exit 2
}

refuse_retired_apply() {
  # 2026-11-10: the host is converged by the native `genarch` engine. A real apply here would
  # restore the shell engine beside it and give the host two writers for the same files — the
  # one failure mode the cutover exists to prevent. Dry-run stays available (read-only).
  # Only the live root is guarded: a set ECO_ROOT is a fixture tree, and the gate itself
  # applies into fixtures. The intent-tree seam (ECO_STATE) decides where the marker is read.
  [[ -z $ECO_ROOT ]] || return 0
  if [[ -e $ECO_STATE/RETIRED.md ]]; then
    {
      printf 'eco: retired: this tree no longer owns the host (state/RETIRED.md)\n'
      printf 'eco: use genarch (report/apply) — refusing to deploy the shell engine again\n'
    } >&2
    exit 2
  fi
}

cmd_report() {
  local json=$1 id
  require_state
  for id in "${CHECK_IDS[@]}"; do
    "${CHECK_READER[$id]}"
  done
  if (( json )); then
    report_json
  else
    report_print
  fi
  exit "$(report_exit)"
}

main() {
  local cmd=report json=0 dry=0
  if (( $# > 0 )); then
    case "$1" in
      report) cmd=report; shift ;;
      apply) cmd=apply; shift ;;
      harvest) cmd=harvest; shift ;;
      --help | -h) usage; exit 0 ;;
      --json) json=1; shift ;;
      *) usage_err "$1" ;;
    esac
  fi
  while (( $# )); do
    case "$1" in
      --json) json=1; shift ;;
      --dry-run) dry=1; shift ;;
      --help | -h) usage; exit 0 ;;
      *) usage_err "$1" ;;
    esac
  done
  case "$cmd" in
    report)
      (( dry == 0 )) || usage_err "--dry-run"
      cmd_report "$json"
      ;;
    apply)
      (( json == 0 )) || usage_err "--json"
      (( dry )) || refuse_retired_apply
      cmd_apply "$dry"
      ;;
    harvest)
      (( json == 0 && dry == 0 )) || usage_err "flag for harvest"
      cmd_harvest
      ;;
  esac
}

# Sourcing seam: tests/run case30 exercises `refuse_retired_apply` below the dispatch. It has to
# stay below, because a real apply with an empty ECO_ROOT re-execs through sudo — a red guard
# tested through the verb would deploy the shell engine from inside the gate (it did, 2026-11-10).
[[ ${ECO_LIB_ONLY:-0} == 1 ]] || main "$@"
