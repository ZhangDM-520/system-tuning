#!/usr/bin/env bash
# tests/stubs/sysctl: canned live sysctl values for the fixture tree. Fixture
# trees are pristine (live == intent), so wanted values come from the repo's
# state/owned sysctl files; the historical vm writeback values stay as fallback.
owned=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../state/owned" 2>/dev/null && pwd)
lookup() {
  local key=$1 f line
  for f in "$owned"/etc/sysctl.d/*.conf "$owned"/etc/sysctl.conf; do
    [[ -f $f ]] || continue
    while IFS= read -r line || [[ -n $line ]]; do
      if [[ $line =~ ^[[:space:]]*([A-Za-z0-9_.]+)[[:space:]]*=[[:space:]]*([^[:space:]#]+) ]] \
        && [[ ${BASH_REMATCH[1]} == "$key" ]]; then
        printf '%s\n' "${BASH_REMATCH[2]}"
        return 0
      fi
    done <"$f"
  done
  case $key in
    vm.dirty_writeback_centisecs) printf '6000\n' ;;
    vm.dirty_expire_centisecs) printf '6000\n' ;;
    *) return 1 ;;
  esac
}
for a in "$@"; do
  case "$a" in
    -*) ;;
    *) lookup "$a" || { echo "sysctl stub: unknown key $a" >&2; exit 1; } ;;
  esac
done
exit 0
